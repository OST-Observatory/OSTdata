SECRET_KEY=____secret_key_used_in_production+++keep_secret+++
DJANGO_ENV=development
# DJANGO_ENV must be development or production (fail-closed).

DATABASE_NAME=ostdatadb
DATABASE_USER=ostdatauser
DATABASE_PASSWORD=long_database_password
DATABASE_HOST=localhost
DATABASE_PORT=
DEVICE=your_device_name_used_in_production
ALLOWED_HOSTS=server_url,server_ip,localhost
LOG_DIR=logs/
DEFAULT_FROM_EMAIL=example@email.com
TRUSTED_ORIGIN=https://polaris.astro.physik.uni-potsdam.de
DATA_DIRECTORY=/archive/ftp/

# Celery / Redis (prefer AUTH + localhost bind)
# CELERY_BROKER_URL=redis://:password@127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://:password@127.0.0.1:6379/1

# Production TLS / proxy (enable carefully after staging verifies X-Forwarded-Proto)
# SECURE_SSL_REDIRECT=false
# SECURE_PROXY_SSL_HEADER=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false

# SPA: async ZIP download job polling / quotas
# DOWNLOAD_JOB_POLL_INTERVAL_MS=2000
# DOWNLOAD_JOB_MAX_WAIT_MS=2700000
# DOWNLOAD_JOB_MAX_FILES=500
# DOWNLOAD_JOB_MAX_BYTES=10737418240
# DOWNLOAD_JOB_MAX_CONCURRENT_ANON=2
# DOWNLOAD_JOB_MAX_CONCURRENT_USER=5
# DOWNLOAD_JOB_MAX_CONCURRENT_GLOBAL=20
# DOWNLOAD_JOB_TMP_DIR=/var/lib/ostdata/download_jobs

# Thumbnails / solar uploads
# THUMBNAIL_MAX_SOURCE_BYTES=524288000
# THUMBNAIL_MAX_PIXELS=50000000
# SOLAR_IMAGE_MAX_UPLOAD_BYTES=10485760

# LDAP (production requires ldaps:// or LDAP_START_TLS=true)
# LDAP_SERVER_URI=ldaps://ldap.example.com:636
# LDAP_START_TLS=false
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(uid=%(user)s)
# Verify TLS certificates in production (do not disable CERT_REQUIRED).

# SIMBAD auxiliary objects in observation-run FOV (Celery worker required; beat when enabled).
# AUX_OBJECTS_ENABLED=True

# Session cookies (SPA auth). Production subpath defaults match FORCE_SCRIPT_NAME=/data_archive.
# SESSION_COOKIE_AGE=1209600
# SESSION_COOKIE_PATH=/data_archive
# CSRF_COOKIE_PATH=/data_archive
