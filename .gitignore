
# If you need to exclude files such as those generated by an IDE, use
# $GIT_DIR/info/exclude or the core.excludesFile configuration variable as
# described in https://git-scm.com/docs/gitignore

*.egg-info
*.pot
*.py[co]
*.sqlite3
__pycache__
MANIFEST
logs/
# Local helper scripts/exports in the project root (anchored: must not hide app modules or tests)
/populate*
/observed_systems*
/upload_*
ostdata/.env
*.log
*.back
.idea/
db.sqlite3.save
read_cr2.py
read_ser.py
ok_but_wrong/
/test_data*
favicon_old.ico
generate_skychart/
*.env
old/
frontend/dist/
cnn_training_data.json

# Generated / local data exports (keep project text files versioned)
logs/**/*.txt
logs/**/*.csv
# Database and other data exports
*.csv
!requirements.txt
!**/robots.txt
!media/docs/Bulk_system_example.csv

# Solar-system object preview images (uploaded via admin; keep directory only)
data/solar_system_images/*
!data/solar_system_images/.gitkeep

# Generated preview cache (SER/video thumbnails, sky view images)
data/ser_thumbnails/*
!data/ser_thumbnails/.gitkeep

# Temporary ZIP files of download jobs
data/download_jobs/*
!data/download_jobs/.gitkeep

# Default DATA_DIRECTORY of a development setup and the data watchdog lock
data/archive/
data/watch_data.lock

# collectstatic output (STATIC_ROOT)
/static/
